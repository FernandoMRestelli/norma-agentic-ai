# Copiar como .env y completar. Nunca subir .env a GitHub.
APP_ENV=development

# LLM (proveedor a definir)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Google Sheets (cuenta de servicio)
GOOGLE_CREDENTIALS_FILE=credentials/google-service-account.json
CATALOG_SHEET_ID=
ORDERS_SHEET_ID=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Base interna
DATABASE_URL=sqlite:///./norma.db
