# Copiar como .env y completar. Nunca subir .env a GitHub.
APP_ENV=development

# LLM de texto. Beta: Gemini free tier, API key gratis en https://aistudio.google.com/apikey
# Ojo: Google usa lo que se manda en el free tier para mejorar sus productos. Solo datos simulados.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# LLM para audio e imagen (modelo pago, a definir). Todavía no se usa.
LLM_VISION_PROVIDER=
LLM_VISION_MODEL=
LLM_VISION_API_KEY=

# Google Sheets (cuenta de servicio)
GOOGLE_CREDENTIALS_FILE=credentials/google-service-account.json
CATALOG_SHEET_ID=
ORDERS_SHEET_ID=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Telegram (canal de prueba de la beta). Token: /newbot en @BotFather
TELEGRAM_BOT_TOKEN=
# Ids numéricos de los integrantes, separados por coma. Si no sabés el tuyo, escribile al bot: te lo dice.
TELEGRAM_ALLOWED_USER_IDS=
# Solo con webhook (servidor): letras, números, _ y -
TELEGRAM_WEBHOOK_SECRET=

# Base interna
DATABASE_URL=sqlite:///./data/norma.db
