# Copiar como .env y completar. Nunca subir .env a GitHub.
# En producción (~/norma-prod) el compose fija APP_ENV=production y DATABASE_URL.
APP_ENV=development

# LLM de texto. Free tier: solo datos simulados. API key gratis en https://openrouter.ai/keys
LLM_PROVIDER=openrouter
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
LLM_API_KEY=
# Alternativa recomendada si el modelo de arriba sigue sin usar tools:
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.8-flash
# LLM_API_KEY=   (clave de https://aistudio.google.com/apikey)

# LLM para audio e imagen. Todavía no se usa.
LLM_VISION_PROVIDER=
LLM_VISION_MODEL=
LLM_VISION_API_KEY=

# Catálogo y pedidos locales. En producción: CATALOG_FILE=data/catalogo.csv (rutas dentro de ~/norma-prod/data)
CATALOG_FILE=data_example/catalogo.csv
ORDERS_FILE=data/pedidos.csv
# Opcional: una fila por línea de cada pedido. Vacío: pedidos_lineas.csv, en la misma carpeta que ORDERS_FILE
ORDER_LINES_FILE=

# Google Sheets (docs/spec/planillas.md §10). Sin los ids, el catálogo sale de CATALOG_FILE y los pedidos van solo a ORDERS_FILE.
# Compartí Sheet 1 como Lector y Sheet 2 como Editor con el client_email del JSON de la cuenta de servicio.
GOOGLE_CREDENTIALS_FILE=credentials/google-service-account.json
# El tramo de la URL de la planilla entre /d/ y /edit
CATALOG_SHEET_ID=
ORDERS_SHEET_ID=
# Opcionales: nombre de la hoja dentro de cada planilla. Vacío: la primera hoja
CATALOG_WORKSHEET=
ORDERS_WORKSHEET=
# Opcional: hoja de Sheet 2 para las líneas de cada pedido (hay que crearla antes). Vacío: no se escriben en Google
ORDER_LINES_WORKSHEET=

# WhatsApp Cloud API (no se usa todavía)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Telegram (canal de prueba de la beta). Token: /newbot en @BotFather
TELEGRAM_BOT_TOKEN=
# Ids numéricos de los integrantes, separados por coma. Si no sabés el tuyo, escribile al bot: te lo dice.
TELEGRAM_ALLOWED_USER_IDS=
# Solo con webhook (servidor): letras, números, _ y -
TELEGRAM_WEBHOOK_SECRET=

# Operador: protege los endpoints /orders/* de la API. Sin valor, esos endpoints quedan cerrados.
OPERATOR_TOKEN=

# Base interna (el compose la fija en /app/data/norma.db)
DATABASE_URL=sqlite:///./data/norma.db

# MLflow: trazas de cada turno del agente (ver README). Apagado no se importa mlflow.
# En producción local no hay servidor de MLflow: queda apagado.
MLFLOW_ENABLED=false
# Con docker compose se usa http://mlflow:5000 (lo fija docker-compose.yml)
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT=norma-agente
# Guarda el texto de los mensajes y el prompt completo. Solo con APP_ENV=development y datos simulados (RNF-03)
MLFLOW_TRACE_TEXT=false
